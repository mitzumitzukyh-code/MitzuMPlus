# Adaptive Route Engine (ruta viva + flechas sobre el pull actual)
#
# Orden obligatorio y por que:
#   ProfileManager   crea la DB de ajustes y perfiles.
#   DataStructure    indexa la ruta, incluido routeClones (enemyIdx+cloneIdx).
#   Solver           es puro, no depende de nadie.
#   EventTracker     consume los dos anteriores.
#   NameplateAnchorProvider  a que frame se ancla la flecha. Unico modulo que
#                    conoce Threat Plates, Plater y ElvUI.
#   RouteArrows      renderizador puro de flechas.
#   PullNavigator    estado del pull actual.
#   PullHUD          pinta "PULL 4 / 21"; se suscribe a PullNavigator AL CARGAR,
#                    asi que el navegador tiene que ir antes.
#   PullUnitResolver puente clon <-> placa viva; engancha sus avisos a
#                    RouteArrows AL CARGAR, asi que va despues de el.
#   Bootstrap        lo cablea todo al ciclo de vida de la llave.
#
# NameplateHooks.lua ya NO se carga. Era el sistema [SKIP] (velo gris y prefijo
# en el nombre) y decidia a quien marcar por npcID, que no identifica una copia
# concreta de un mob. Lo sustituye RouteArrows. El fichero se deja en disco
# como referencia historica; no debe volver al TOC.
# Rutas nativas EMPAQUETADAS. Existen en una instalacion limpia: sin MDT,
# sin SavedVariables y sin importar nada. Registry.lua va primero, que es
# quien crea la tabla en la que se registran las ocho.
data\Routes\Season2\Registry.lua
data\Routes\Season2\KingsRest.lua
data\Routes\Season2\TempleOfSethraliss.lua
data\Routes\Season2\RubyLifePools.lua
data\Routes\Season2\BlindingVale.lua
data\Routes\Season2\VoidscarArena.lua
data\Routes\Season2\DenOfNalorakk.lua
data\Routes\Season2\MurderRow.lua
data\Routes\Season2\AltarOfFangs.lua
data\MDTEnemyData.lua
# Fotografia por clon: g/sublevel/x/y/patrol. Contexto estatico, no identidad.
data\MDTPhysicalGroupData.lua
modules\AdaptiveRoute\ProfileManager.lua
modules\AdaptiveRoute\DataStructure.lua
# Consultas y diagnostico de la fotografia fisica. No participa en Guidance.
modules\AdaptiveRoute\PhysicalGroupMetadata.lua
modules\AdaptiveRoute\SolverAlgorithm.lua
modules\AdaptiveRoute\EventTracker.lua
# NameplateAnchorProvider: a que frame se ancla la flecha. Threat Plates,
# Plater, ElvUI o la placa de Blizzard. Va ANTES que RouteArrows, que lo
# consulta en cada MarkUnit. Es el unico modulo que conoce esos addons.
modules\AdaptiveRoute\NameplateAnchorProvider.lua
modules\AdaptiveRoute\RouteArrows.lua
modules\AdaptiveRoute\PullNavigator.lua
modules\AdaptiveRoute\PullHUD.lua
modules\AdaptiveRoute\PullUnitResolver.lua
# CAPA DE EVIDENCIAS (fase 3). Dos modulos SIN dependencias: no conocen la
# ruta, ni el pull, ni Guidance, y nadie los consulta todavia. Solo los
# llama /emp evidence. Para retirarlos, borra estas dos lineas.
modules\AdaptiveRoute\EngagementEvidence.lua
modules\AdaptiveRoute\UnitLinkEvidence.lua
# Correlacion FASE 3C: solo diagnostico; no se conecta a Guidance ni flechas.
modules\AdaptiveRoute\PhysicalGroupCorrelation.lua
# Experimentales de la misma capa: casts y auras. Igual de aislados, y solo
# los llaman /emp castevidence y /emp auraevidence.
modules\AdaptiveRoute\CastEvidence.lua
modules\AdaptiveRoute\AuraEvidence.lua
# EventCastEvidence: los mismos casts, pero por evento en vez de por sondeo.
# Es el unico de la capa con frame propio; escucha desde que carga.
modules\AdaptiveRoute\EventCastEvidence.lua
# PackEvidence: la FORMA del pack, no su identidad. Consume las otras
# evidencias y un pull que le pasa quien llama; no guarda nada.
modules\AdaptiveRoute\PackEvidence.lua
# SPIKE (fase S). Aislado y reversible: nadie depende de el, solo lo
# llaman comandos de depuracion. Para retirarlo, borra esta linea.
modules\AdaptiveRoute\LiveEnemyResolver.lua
# Decision y presentacion de flechas de ruta. Van despues de RouteArrows y
# LiveEnemyResolver, a los que consultan; el Presenter registra sus propios
# eventos de nameplate para no pisar los ganchos de PullUnitResolver.
modules\GuidanceEngine.lua
modules\RouteArrowPresenter.lua
# ARROW DEMO (experimental, apagado por defecto). Pipeline VISUAL aparte:
# no llama al resolver ni a Guidance, no escribe identidad y no mueve el
# pull. Comparte con produccion solo el pool de RouteArrows, por su API
# publica. Orden: generaciones -> telemetria -> demo (se suscriben al cargar).
# Para retirarlo, borra estas tres lineas.
modules\AdaptiveRoute\NameplateGenerations.lua
modules\AdaptiveRoute\ArrowDemoTelemetry.lua
modules\AdaptiveRoute\ArrowDemo.lua
modules\AdaptiveRoute\Bootstrap.lua

